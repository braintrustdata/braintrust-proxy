{
  "repository": "https://github.com/vercel/examples.git",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apis/*",
    "packages/*"
  ],
  "scripts": {
    "preinstall": "node -e \"const userAgent = process.env.npm_config_user_agent || ''; if (process.env.INIT_CWD === process.cwd() && !userAgent.includes('pnpm/')) { console.error('Use pnpm in this repo.'); process.exit(1); }\"",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.27.0",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=10.27.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "eslint": "^9.39.4",
    "eslint-config-turbo": "latest",
    "prettier": "3.3.2",
    "tsx": "^4.8.1",
    "turbo": "^2.9.14",
    "vite": "7.3.7",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.33.0",
  "resolutions": {
    "handlebars": "4.7.10",
    "protobufjs": "7.5.8",
    "zod": "3.25.34"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "qs": "^6.15.1",
      "path-to-regexp@<1": "^0.1.13",
      "ws": ">=8.20.1",
      "sharp@<0.35.5": "^0.35.5",
      "undici@>=7 <7.30.1": "^7.30.1",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1",
      "@babel/core@<7.29.6": "^7.29.6",
      "baseline-browser-mapping@<2.11.0": "^2.11.0",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=5 <5.0.12": "^5.0.12",
      "browserslist@<4.28.7": "^4.28.7",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "minimatch@>=10 <11.0.1": "^11.0.1",
      "postcss-selector-parser@<6.1.5": "^6.1.5",
      "source-map-js@<1.2.2": "^1.2.2"
    }
  }
}
